{
  /*
   * Type-checks the serverless functions. NOT part of `npm run build` — the
   * host compiles these itself, and wiring them into the site build is what
   * made a missing directory able to break a deploy.
   *
   * Run on demand:  npm run typecheck:server
   *
   * WHY "nodenext" AND NOT "bundler":
   * These files are not bundled. Vercel compiles each .ts under api/ to .js,
   * leaves the import specifiers exactly as written, and Node's ESM resolver
   * runs the result. "nodenext" is that same resolver, so it is the only
   * setting that makes the type-checker agree with production. It requires an
   * explicit extension on every relative import, and it resolves
   * "./x.js" back to "./x.ts" — which is precisely the pattern the runtime
   * needs. A wrong specifier is now a compile error here instead of an
   * ERR_MODULE_NOT_FOUND after deploy.
   */
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["api/**/*.ts", "netlify/**/*.ts"]
}
